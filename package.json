{
  "name": "opentui-markdown-render",
  "version": "0.2.11",
  "description": "OpenTUI Markdown renderer with optional native LaTeX math",
  "type": "module",
  "license": "MIT",
  "bin": {
    "otmd": "bin/otmd.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./src/core/index.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    }
  },
  "files": [
    "src",
    "dist",
    "bin",
    "native/Cargo.toml",
    "native/Cargo.lock",
    "native/build.rs",
    "native/src",
    "prebuilds",
    "themes",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build:cli": "bun run scripts/build-cli.ts",
    "build:library": "bun run scripts/build-library.ts",
    "build:native": "bun run scripts/build-native.ts",
    "build:native:portable": "bun run scripts/build-native.ts --portable",
    "generate:examples": "bun run scripts/generate-example-assets.ts",
    "demo": "bun --preload @opentui/solid/preload examples/app.tsx",
    "demo:plain": "bun --preload @opentui/solid/preload examples/app.tsx plain.md",
    "demo:tables": "bun --preload @opentui/solid/preload examples/app.tsx tables.md",
    "demo:mermaid": "bun --preload @opentui/solid/preload examples/app.tsx mermaid.md",
    "demo:merman-ext": "bun --preload @opentui/solid/preload examples/app.tsx merman-ext.md",
    "demo:math": "bun --preload @opentui/solid/preload examples/app.tsx math.md",
    "demo:images": "bun --preload @opentui/solid/preload examples/app.tsx images.md",
    "demo:mixed": "bun --preload @opentui/solid/preload examples/app.tsx rendered.md",
    "demo:frame": "bun --preload @opentui/solid/preload examples/app.tsx frame.md",
    "test": "bun test --preload @opentui/solid/preload --timeout 30000",
    "typecheck": "tsgo --noEmit",
    "verify": "bun run build:native && bun run build:library && bun run build:cli && bun run typecheck && bun run test && bun run verify:native",
    "verify:portable": "bun run build:native:portable && bun run verify:prebuild && bun run build:library && bun run build:cli && bun run typecheck && bun run test && bun run verify:native",
    "verify:native": "cargo test --manifest-path native/Cargo.toml",
    "verify:prebuild": "bun run scripts/verify-prebuild.ts",
    "prepack": "bun run verify:prebuild && bun run build:library && bun run build:cli",
    "demo:all": "bun --preload @opentui/solid/preload examples/app.tsx all.md"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.12",
    "@opentui/solid": ">=0.5.12",
    "solid-js": ">=1.9.0"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3",
    "entities": "7.0.1",
    "gifuct-js": "2.1.2",
    "marked": "17.0.1",
    "string-width": "7.2.0"
  },
  "devDependencies": {
    "@opentui/core": "0.8.2",
    "@opentui/solid": "0.8.2",
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.4.0",
    "@typescript/native-preview": "7.0.0-dev.20251207.1",
    "solid-js": "1.9.18"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
