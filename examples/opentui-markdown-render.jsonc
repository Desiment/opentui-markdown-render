{
  // The demo discovers this file by walking up from the examples directory.
  // Every section is optional; what is missing keeps the bundled default.
  "statusline": {
    "style": "bar",
    "highlight": "title",
    "fields": ["title", "mode", "protocol", "cell", "position", "hint"],
    "separator": " · ",
    "border": "top"
  },
  // The look of every heading level. The colours live in the theme, the
  // attributes and the spacing here.
  "headings": {
    "levels": {
      "1": { "bold": true, "underline": true, "marginTop": 2 },
      "2": { "bold": true },
      "3": { "bold": true, "dim": true }
    }
  },
  // The window around the whole document. The width is the outer width; the
  // text area is narrower by the border and the padding.
  "frame": {
    "enabled": true,
    "width": 100,
    "align": "center",
    "style": "rounded",
    "paddingX": 1
  },
  // Tables size their columns to the content; a wider one pans sideways
  // instead of stretching over the window.
  "tables": {
    "widthMode": "content",
    "overflow": "scroll",
    "cellPaddingX": 1
  }
}
